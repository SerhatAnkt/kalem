# Bu dosyayı .env adıyla kopyalayın.
# Varsayılan demo API çağrısı yapmaz. LLM modu için 0 yapın.
KALEM_OFFLINE=1

# LLM çağrıları başarısız olduğunda hata ver; kural tabanlı yedeğe geçme.
# 0 seçilirse sağlayıcı hatalarında kural tabanlı yedek kullanılabilir.
KALEM_STRICT=1

# Yalnız kullanacağınız sağlayıcının anahtarını doldurun.
# Sağlayıcı/model seçimi: config/settings.yaml
GROQ_API_KEY=
GEMINI_API_KEY=
